# Copy to .env for local development; npm run dev loads it before optional DPAPI credentials.
# Configure production values separately through Netlify project settings.
# On the authorized Windows workstation, encrypted DPAPI secrets are loaded outside this repo.

# Functions scope, production context. Never use a VITE_ prefix for secrets.
# NEARLYHUMAN_RUNTIME=netlify
# Set the above explicitly for production Functions; keep it omitted locally.
NEAR_AI_API_KEY=
NEARLYHUMAN_RELAY_KEY=
NEARLYHUMAN_SESSION_SECRET=

# Public chain configuration; this release serves the deployed testnet collection.
NEARLYHUMAN_CHAIN_ID=46630
NEARLYHUMAN_COLLECTION=0x998551395f8a0c4ebd1f883b8c18a41d2cecabfb
NEARLYHUMAN_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEARLYHUMAN_ORIGINS=https://nearlyhuman.netlify.app,http://127.0.0.1:5173,http://localhost:5173

# Finite operator allocation. Raise only when matching AI credit and relay gas exist.
NEARLYHUMAN_AI_BUDGET_USD=0.9
NEARLYHUMAN_WALLET_ATTEMPTS=12
NEARLYHUMAN_GLOBAL_ATTEMPTS=100
NEARLYHUMAN_CONCURRENCY=3

# Netlify build/runtime settings, set through project configuration.
NODE_VERSION=22
AWS_LAMBDA_JS_RUNTIME=nodejs22.x

# Local-only options. Omit from production.
# Omit NEARLYHUMAN_RUNTIME locally so development uses its durable private local store.
# PORT=5173
# NEARLYHUMAN_DATA_DIR=<absolute private local data directory>
# NEARLYHUMAN_QA_WALLET=1

# Deploy-only values are not application runtime configuration.
# NEARLYHUMAN_OWNER_PRIVATE_KEY is injected securely for an authorized deploy; never save it here.
# A future mainnet deployment additionally requires verified NEARLYHUMAN_PRICE_FEED
# and NEARLYHUMAN_PRICE_MAX_AGE, plus independent mainnet owner and relay funding.
