# Copy to .env for local development. npm run dev loads it before starting.
# Configure production values separately in Netlify project settings.
# Keep secrets in Functions scope, production context. Never prefix them VITE_.
NEAR_AI_API_KEY=
NEARLYHUMAN_RELAY_KEY=
NEARLYHUMAN_SESSION_SECRET=

# Explicitly set this for production Functions; leave it omitted locally.
# NEARLYHUMAN_RUNTIME=netlify
NEARLYHUMAN_ORIGINS=https://nearlyhuman.netlify.app,http://127.0.0.1:5173,http://localhost:5173

# EVM world. Use the exact verified identity in contracts/deployments/robinhood-testnet.json.
# The campaign is an existing funded allocation; changing a label does not fund another.
NEARLYHUMAN_EVM_CHAIN_ID=46630
# NEARLYHUMAN_EVM_RUNTIME_JSON={...verified public identity...}
# NEARLYHUMAN_EVM_RPC_URL=https://rpc.testnet.chain.robinhood.com
# NEARLYHUMAN_EVM_CAMPAIGN=nearlyhuman-v2-testnet-20261102
# NEARLYHUMAN_EVM_GUEST_ID=1
# NEARLYHUMAN_EVM_GUEST_DAY=1
# Optional explicit native allowances in wei, separate from the relay gas floor.
# Default zero does not claim to price AI in ETH.
# NEARLYHUMAN_EVM_INFERENCE_RESERVE_WEI=0
# NEARLYHUMAN_EVM_HOSTING_RESERVE_WEI=0

# Native NEAR Testnet is a separate world. Use contracts/deployments/near-testnet.json.
# Both worlds share the same existing funded campaign; never clone its ledger.
# NEARLYHUMAN_NEAR_ENABLED=1
# NEARLYHUMAN_NEAR_RUNTIME_JSON={...verified native public identity...}
# NEARLYHUMAN_NEAR_RELAY_KEY=<private ed25519 key>
# NEARLYHUMAN_NEAR_CAMPAIGN=nearlyhuman-v2-testnet-20261102
# NEARLYHUMAN_NEAR_GUEST_ID=1
# NEARLYHUMAN_NEAR_GUEST_DAY=1

# Netlify build/runtime setting. Functions use the supported build Node runtime.
NODE_VERSION=24

# Local-only options; omit from production. Durable records live outside the checkout.
# PORT=5173
# NEARLYHUMAN_DATA_DIR=<absolute private local data directory>
# NEARLYHUMAN_EVM_LOCAL=1

# Existing deployed NEARLYHUMAN_V2_* settings remain supported by server/config.ts.
# Source cleanup does not change stored campaign IDs, queue formats, or ledger keys.
# Deploy-only owner keys are injected securely for an authorized deploy; never save them here.
