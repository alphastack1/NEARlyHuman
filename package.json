{
  "name": "nearlyhuman",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/site/build-public-pages.ts && tsx scripts/site/export-contracts.ts",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:domain": "tsx --test src/domain/domain.test.ts src/domain/behavior-memory.test.ts src/domain/choice-policy.test.ts",
    "test:service": "tsx --test server/service.test.ts server/storage.test.ts server/choice-prompt.test.ts"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "@hot-labs/near-connect": "0.12.0",
    "@netlify/blobs": "11.1.7",
    "@scure/base": "2.4.0",
    "near-api-js": "7.4.0",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.14"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "solc": "0.8.38",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
