# Keep maintained text deterministic across Windows and Unix checkouts.
* text=auto eol=lf

# Preserve exact bytes of content-addressed recorded preview snapshots.
public/assets/preview/*.json -text

# Content-addressed contract inputs preserve their reviewed exact byte streams,
# including the original native sources' recorded CRLF line endings.
contracts/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Canonical artwork was recorded with LF endings.
src/art/rooster.ts text eol=lf
src/art/rooster-data.ts text eol=lf
